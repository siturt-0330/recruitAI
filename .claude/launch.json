{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "harness",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "harness"
      ],
      "port": 5179
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "wrangler",
        "dev",
        "--cwd",
        "worker",
        "--port",
        "8788",
        "--local-upstream",
        "localhost:8788"
      ],
      "port": 8788
    },
    {
      "name": "column",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "worker",
        "wrangler",
        "dev",
        "--cwd",
        "worker",
        "--port",
        "8790",
        "--local-upstream",
        "localhost:8790",
        "--var",
        "COLUMN_DEV_LOGIN:1",
        "--var",
        "COLUMN_ADMIN_EMAILS:admin@example.com"
      ],
      "port": 8790
    }
  ]
}
