{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recruitai-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  // 拡張機能が使う URL。公開後に変えると拡張機能が止まるので、変えないこと
  "routes": [
    { "pattern": "api.rakuraku-entry.com", "custom_domain": true },
    { "pattern": "rakuraku-entry.com", "custom_domain": true }
  ],
  // 公式サイト（site/）。ファイルがある URL はそのまま返し、ないものは下の API の処理に回す。
  // コラム（/column 以下）は Worker が先に処理する（記事のページを組み立てるため）。コラムの CSS・JS は /column-assets/ に置き、静的に返す
  "assets": { "directory": "../site", "binding": "ASSETS", "html_handling": "drop-trailing-slash", "run_worker_first": ["/google*.html", "/column", "/column/*"] },
  // コラムのデータ（記事・書き手・スキ・フォロー・コメントなど）。表は migrations/ のマイグレーションで作る
  "d1_databases": [
    { "binding": "COLUMN_DB", "database_name": "rakuraku-column", "database_id": "adaa1c64-3046-4e49-9c1b-458e0a8d2694", "migrations_dir": "migrations" }
  ],
  // コラムの画像（見出し画像・本文の画像・アイコン）
  "r2_buckets": [{ "binding": "COLUMN_IMAGES", "bucket_name": "rakuraku-column-images" }],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // 1日の利用回数を数える Durable Object（SQLite）
  "durable_objects": {
    "bindings": [{ "name": "QUOTA", "class_name": "Quota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Quota"] }],
  "vars": {
    // 拡張機能を公開して ID が決まったら "chrome-extension://<ID>" を入れる（空なら全部許可）
    "ALLOWED_ORIGINS": "chrome-extension://kdppelkdplekjbiehpodfmmfcpbbfeho",
    // 1日あたりの上限（日本時間0時にリセット）。全体の上限 × 1回の料金 が1日の最大の API 使用料になる
    "LIMIT_PER_INSTALL": "30",
    "LIMIT_PER_IP": "60",
    "LIMIT_GLOBAL": "3000",
    // "1" にすると OpenAI を呼ばずに決まった答えを返す（ローカルの動作確認用）
    "MOCK_AI": "0",
    // ポップアップのスポンサー枠。空なら出さない。例：{"title":"〇〇","body":"一言","url":"https://...","cta":"見てみる"}
    "SPONSOR": "",
    // Web 版からロゴを取りに来てよい Origin（カンマ区切り）と、1日の上限
    "APP_ORIGINS": "https://app.rakuraku-entry.com,http://localhost:3100",
    "LOGO_LIMIT_PER_IP": "300",
    "LOGO_LIMIT_GLOBAL": "20000"
  }
  // シークレット（リポジトリには書かない）:
  //   npx wrangler secret put OPENAI_API_KEY
  //   npx wrangler secret put ADMIN_TOKEN
  //   npx wrangler secret put GOOGLE_CLIENT_ID      … コラムの Google ログイン（Google Cloud の OAuth クライアント）
  //   npx wrangler secret put GOOGLE_CLIENT_SECRET
  //   npx wrangler secret put COLUMN_ADMIN_EMAILS   … コラムの運営にする Google アカウント（カンマ区切り。リポジトリに書かないためシークレットにする）
}
